# Node (tools/verify.js & JSDOM tests only — the extension itself needs no build)
node_modules/

# Python virtual environments & bytecode
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated / local runtime state (secrets and logs must never be committed)
.DS_Store
Thumbs.db
*.log
*.bak
.zs_token
config.json.tmp
logs/
ZeroScript Demo/config.json
Unselected files/

# 4.7.0: modern Python tooling leaves these behind; none of them are ever needed
# to run the bridge, and .ruff_cache/.mypy_cache can hold absolute paths.
.ruff_cache/
.mypy_cache/
.venv*/
venv/
*.egg-info/
build/
dist/
# OS/editor artifacts outside the macOS case the block above covers
*.swp
*~
.vscode/
.idea/
