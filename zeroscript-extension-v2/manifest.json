{
  "manifest_version": 3,
  "name": "ZeroScript MAX \u00d7 Roblox Studio Agent",
  "version": "4.5.0",
  "description": "ZeroScript with bounded execution modes, memory/wall tools, authenticated bridge teams and tab recovery controls.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://grok.com/*",
    "https://x.ai/*",
    "https://poe.com/*",
    "https://chat.mistral.ai/*",
    "https://*.mistral.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZeroScript MAX 4.3.0",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "core/safe.js",
        "core/config.js",
        "core/agent_stability.js",
        "core/parser.js",
        "core/memory_wall.js",
        "core/sandbox.js",
        "core/prompt_enhancer.js",
        "core/plan_wall.js",
        "core/peer_wall.js",
        "core/agent_hub.js",
        "providers/deepseek.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core/safe.js",
        "providers/chatgpt-cm.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
